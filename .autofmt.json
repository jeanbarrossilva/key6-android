[
  {
    "identifier": "java",
    "arguments": ["google-java-format", "--replace"],
    "extensions": [".java"],
    "exclusions": [
      "/keychain/src/main/java/de/xformerfhs/securesecretkeyspec/*",
      "/keychain/src/test/java/com/kevinmost/junit_retry_rule/*"
    ]
  },
  {
    "identifier": "kt",
    "arguments": ["ktlint", "--format"],
    "extensions": [".kt", ".kts"]
  },
  {
    "identifier": "zig",
    "arguments": ["zig", "fmt"],
    "extensions": [".zig", ".zon"]
  }
]
