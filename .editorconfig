root = true

[*]
charset = utf-8
end_of_line = lf
ij_any_keep_blank_lines_in_code = 1
ij_continuation_indent_size = 2
ij_visual_guides = 80
indent_size = 2
indent_style = space
insert_final_newline = true
max_line_length = 80
trim_trailing_whitespace = true

[*.{kt,kts}]
ij_kotlin_allow_trailing_comma = false
ij_kotlin_allow_trailing_comma_on_call_site = false
ij_kotlin_imports_layout = *
ktlint_standard_comment-wrapping = disabled
ktlint_standard_no-single-line-block-comment = disabled

[*.kt]
ktlint_standard_filename = disabled

[*Tests.kt]
ktlint_standard_max-line-length = disabled

[/app/build/**/*.kt]
ktlint_standard = disabled

[keychain/src/main/java/com/jeanbarrossilva/key6/keychain/key/PlainPassword.kt]
ktlint_argument_list_wrapping_ignore_when_parameter_count_greater_or_equal_than = 1

[*.xml]
ij_xml_align_attributes = true
ij_xml_attribute_wrap = on_every_item
ij_xml_continuation_indent_size = 2
ij_xml_keep_line_breaks = false
ij_xml_keep_whitespaces = false
ij_xml_space_inside_empty_tag = true
ij_xml_text_wrap = normal
